# ---------------------------------------------------------------------------
# Copiar a .env.local y pedir los valores reales. NUNCA commitear .env.local
#
# NEXT_PUBLIC_ significa que la variable TERMINA EN EL NAVEGADOR y es visible
# para cualquiera. Poner ese prefijo en un secreto es publicarlo.
# Ver docs/12-convenciones-de-desarrollo.md
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Estos dos valores los imprime `npm run db:start` al levantar Supabase local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SALTA TODAS LAS POLÍTICAS DE RLS. Solo servidor.
# Uso permitido únicamente en: reserva pública, webhooks y trabajos programados.
SUPABASE_SECRET_KEY=

# --- WhatsApp Cloud API (Meta) -------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Mercado Pago ---------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Email ----------------------------------------------------------------
RESEND_API_KEY=

# --- Trabajos programados -------------------------------------------------
# Protege /api/cron/*. Generar con: openssl rand -hex 32
CRON_SECRET=

# --- Aplicación -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
